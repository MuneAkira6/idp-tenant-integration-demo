# Every setting of this demo, with a DUMMY value. No real secret is ever written into this repository
# (goal-brief.md, red line 5). The root .gitignore of this repository is a given file and does not list
# `.env`, so the run does not create one here: `pnpm stack:up` writes the real values into
# `${TMPDIR:-/tmp}/acme-idp-demo.env`, outside the repository, and passes that file to Compose with
# `--env-file`. To run the stack by hand, copy this file to a path outside the repository, replace the
# dummies, and use `docker compose --env-file <that path> up -d`.
#
# The defaults below are the fail-closed defaults of data-model.md, "Configuration defaults"
# (constitution VI): with the file absent, every platform token and every event is refused, no device
# pull runs, and no tenant is integrated.

# ---------------------------------------------------------------------------
# Keycloak (the platform's IdP stand-in) — used by compose.yaml and the realm imports
# ---------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=dummy-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=dummy-admin-password
KEYCLOAK_SEED_PASSWORD=dummy-seed-password
ACME_TASKS_SECRET_TENANT_A=dummy-acme-tasks-secret-tenant-a
ACME_TASKS_SECRET_TENANT_B=dummy-acme-tasks-secret-tenant-b
ACME_REPORTS_SECRET_TENANT_A=dummy-acme-reports-secret-tenant-a
ACME_REPORTS_SECRET_TENANT_B=dummy-acme-reports-secret-tenant-b
ACME_TASKS_SHORTLIVED_SECRET_TENANT_A=dummy-shortlived-secret-tenant-a
ACME_TASKS_SHORTLIVED_SECRET_TENANT_B=dummy-shortlived-secret-tenant-b
ACME_TASKS_SYNC_SECRET=dummy-acme-tasks-sync-secret

# ---------------------------------------------------------------------------
# The application (apps/api, port 18400)
# ---------------------------------------------------------------------------
API_PORT=18400
API_PUBLIC_URL=http://localhost:18400
WEB_PORT=18401
# Where a completed sign-in lands; the pages are the web client's (apps/web, G5).
WEB_BASE_URL=http://localhost:18401
MOCK_PLATFORM_PORT=18402
MONGO_URL=mongodb://127.0.0.1:18417
MONGO_DB=acme_tasks
# The password of the seeded users of `local`, the tenant that is not integrated (T011).
LOCAL_SEED_PASSWORD=dummy-local-password

# Empty by default: with no issuer configured every platform token is refused and platform sign-in is
# unavailable (FR-029). Format: <tenantId>=<issuer>, comma separated.
PLATFORM_ISSUERS=
# The audience every platform token must carry (FR-008). Empty is treated as "not configured".
PLATFORM_AUDIENCE=acme-tasks-api
# The confidential clients of the tenant realms, used by the authorisation code flow (FR-001).
# Format: <tenantId>=<clientId>:<clientSecret>, comma separated. Empty: platform sign-in unavailable.
PLATFORM_CLIENTS=

# None by default: without it the API refuses to start the platform sign-in (fails closed).
# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# ---------------------------------------------------------------------------
# Webhooks — one secret per event type (research R-6). Empty: every event of that type is refused
# with 401 not_configured (FR-029).
# ---------------------------------------------------------------------------
WEBHOOK_SECRET_TENANT_CREATED=
WEBHOOK_SECRET_TENANT_DELETED=

# ---------------------------------------------------------------------------
# The platform stand-in (apps/mock-platform, port 18402)
# ---------------------------------------------------------------------------
PLATFORM_API_BASE_URL=http://localhost:18402
# The client-credentials client the API uses for tenant and device lookups (research R-9).
PLATFORM_SYNC_ISSUER=http://localhost:18480/realms/platform
PLATFORM_SYNC_CLIENT_ID=acme-tasks-sync
PLATFORM_SYNC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Device pull (FR-025) — off by default
# ---------------------------------------------------------------------------
DEVICE_PULL_ENABLED=false
DEVICE_PULL_PAGE_SIZE=200
