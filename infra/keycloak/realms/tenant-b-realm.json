{
  "realm": "tenant-b",
  "displayName": "Tenant B",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "client": {
      "acme-tasks": [
        {
          "name": "tasks-user",
          "description": "platform role mapped to the application role member"
        },
        {
          "name": "tasks-manager",
          "description": "platform role mapped to the application role manager"
        },
        {
          "name": "tasks-admin",
          "description": "platform role mapped to the application role admin"
        }
      ],
      "acme-reports": [
        {
          "name": "reports-viewer",
          "description": "platform role mapped to the application role member"
        },
        {
          "name": "reports-admin",
          "description": "platform role mapped to the application role admin"
        },
        {
          "name": "legacy-viewer",
          "description": "platform role with no mapping (FR-013)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "acme-tasks",
      "name": "Acme Tasks",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:18400/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:18401"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:18401/*+http://localhost:18400/*"
      },
      "protocolMappers": [
        {
          "name": "acme-tasks-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "acme-tasks-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "acme-reports",
      "name": "Acme Reports",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:18400/auth/callback"
      ],
      "webOrigins": []
    },
    {
      "clientId": "acme-tasks-shortlived",
      "name": "Acme Tasks (1 s access tokens, for the expired-token test of Q5)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "1"
      },
      "protocolMappers": [
        {
          "name": "acme-tasks-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "acme-tasks-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "bob",
      "email": "bob@tenant-b.example",
      "firstName": "Bob",
      "lastName": "Bergstrom",
      "enabled": true,
      "emailVerified": true,
      "clientRoles": {
        "acme-tasks": [
          "tasks-user"
        ]
      }
    },
    {
      "username": "bianca",
      "email": "bianca@tenant-b.example",
      "firstName": "Bianca",
      "lastName": "Bruno",
      "enabled": true,
      "emailVerified": true,
      "clientRoles": {
        "acme-tasks": [
          "tasks-admin"
        ]
      }
    }
  ]
}
